from flask import Flask, render_template, request, redirect, url_for, flash, session
from flask_sqlalchemy import SQLAlchemy
from flask_login import LoginManager, UserMixin, login_user, login_required, logout_user, current_user
from werkzeug.security import generate_password_hash, check_password_hash
import os

app = Flask(__name__)
app.config['SECRET_KEY'] = 'your-secret-key'  # Change this to a secure secret key
app.config['SQLALCHEMY_DATABASE_URI'] = 'mysql://sree:root@localhost/store'
app.config['SQLALCHEMY_TRACK_MODIFICATIONS'] = False

db = SQLAlchemy(app)
login_manager = LoginManager()
login_manager.init_app(app)
login_manager.login_view = 'login'

# Models
class User(UserMixin, db.Model):
    id = db.Column(db.Integer, primary_key=True)
    username = db.Column(db.String(20), unique=True, nullable=False)
    password = db.Column(db.String(20), nullable=False)

class Book(db.Model):
    BookName = db.Column(db.String(30), primary_key=True)
    Genre = db.Column(db.String(20))
    Quantity = db.Column(db.Integer)
    Author = db.Column(db.String(20))
    Publication = db.Column(db.String(30))
    Price = db.Column(db.Integer)

class SellRecord(db.Model):
    id = db.Column(db.Integer, primary_key=True)
    CustomerName = db.Column(db.String(20))
    PhoneNumber = db.Column(db.String(10), unique=True)
    BookName = db.Column(db.String(30), db.ForeignKey('book.BookName'))
    Quantity = db.Column(db.Integer)
    Price = db.Column(db.Integer)
    Total_Amount = db.Column(db.Integer)

@login_manager.user_loader
def load_user(user_id):
    return User.query.get(int(user_id))

# Routes
@app.route('/')
def index():
    return render_template('index.html')

@app.route('/signup', methods=['GET', 'POST'])
def signup():
    if request.method == 'POST':
        username = request.form['username']
        password = request.form['password']
        
        if User.query.filter_by(username=username).first():
            flash('Username already exists')
            return redirect(url_for('signup'))
        
        new_user = User(username=username, password=password)
        db.session.add(new_user)
        db.session.commit()
        flash('Signup successful!')
        return redirect(url_for('login'))
    
    return render_template('signup.html')

@app.route('/login', methods=['GET', 'POST'])
def login():
    if request.method == 'POST':
        username = request.form['username']
        password = request.form['password']
        
        user = User.query.filter_by(username=username).first()
        if user and user.password == password:
            login_user(user)
            return redirect(url_for('dashboard'))
        
        flash('Invalid username or password')
    return render_template('login.html')

@app.route('/dashboard')
@login_required
def dashboard():
    return render_template('dashboard.html')

@app.route('/add_book', methods=['GET', 'POST'])
@login_required
def add_book():
    if request.method == 'POST':
        book = Book(
            BookName=request.form['book_name'],
            Genre=request.form['genre'],
            Quantity=int(request.form['quantity']),
            Author=request.form['author'],
            Publication=request.form['publication'],
            Price=int(request.form['price'])
        )
        
        existing_book = Book.query.get(book.BookName)
        if existing_book:
            existing_book.Quantity += book.Quantity
            flash('Book quantity updated successfully!')
        else:
            db.session.add(book)
            flash('Book added successfully!')
        
        db.session.commit()
        return redirect(url_for('dashboard'))
    
    return render_template('add_book.html')

@app.route('/sell_book', methods=['GET', 'POST'])
@login_required
def sell_book():
    if request.method == 'POST':
        book_name = request.form['book_name']
        quantity = int(request.form['quantity'])
        customer_name = request.form['customer_name']
        phone_number = request.form['phone_number']
        
        book = Book.query.get(book_name)
        if book and book.Quantity >= quantity:
            total_amount = book.Price * quantity
            sell_record = SellRecord(
                CustomerName=customer_name,
                PhoneNumber=phone_number,
                BookName=book_name,
                Quantity=quantity,
                Price=book.Price,
                Total_Amount=total_amount
            )
            
            book.Quantity -= quantity
            db.session.add(sell_record)
            db.session.commit()
            flash('Book sold successfully!')
        else:
            flash('Book not available in requested quantity!')
        
        return redirect(url_for('dashboard'))
    
    books = Book.query.all()
    return render_template('sell_book.html', books=books)

@app.route('/search_books')
@login_required
def search_books():
    search_type = request.args.get('type')
    search_term = request.args.get('term')
    
    if search_type == 'name':
        books = Book.query.filter_by(BookName=search_term).all()
    elif search_type == 'genre':
        books = Book.query.filter_by(Genre=search_term).all()
    elif search_type == 'author':
        books = Book.query.filter_by(Author=search_term).all()
    else:
        books = []
    
    return render_template('search_results.html', books=books)

@app.route('/sell_records')
@login_required
def sell_records():
    records = SellRecord.query.all()
    return render_template('sell_records.html', records=records)

@app.route('/reset_records', methods=['POST'])
@login_required
def reset_records():
    SellRecord.query.delete()
    db.session.commit()
    flash('Sell records have been reset!')
    return redirect(url_for('sell_records'))

@app.route('/available_books')
@login_required
def available_books():
    books = Book.query.order_by(Book.BookName).all()
    return render_template('available_books.html', books=books)

@app.route('/total_income')
@login_required
def total_income():
    total = db.session.query(db.func.sum(SellRecord.Total_Amount)).scalar() or 0
    return render_template('total_income.html', total=total)

@app.route('/logout')
@login_required
def logout():
    logout_user()
    return redirect(url_for('index'))

if __name__ == '__main__':
    with app.app_context():
        db.create_all()
    app.run(debug=True)

