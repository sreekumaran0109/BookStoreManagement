                                        <td>{{ book.BookName }}</td>
                                        <td>{{ book.Genre }}</td>
                                        <td>{{ book.Quantity }}</td>
                                        <td>{{ book.Author }}</td>
                                        <td>{{ book.Publication }}</td>
                                        <td>{{ book.Price }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="alert alert-info">
                        No books available in the inventory.
                    </div>
                {% endif %}
                <div class="mt-3">
                    <a href="{{ url_for('dashboard') }}" class="btn btn-outline-secondary">Back to Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

